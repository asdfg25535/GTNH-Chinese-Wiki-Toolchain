# Copy this file to .env and fill in local paths / credentials.

# Minecraft dump directory generated by iouter/GTNH-Dumper:
# https://github.com/iouter/GTNH-Dumper
# The directory should contain files such as advitempanel.json,
# itemicon.json, fluid.json, icons/, and image_redirect.csv.
DUMPS_DIR=E:\Path\To\PrismLauncher\instances\GT_New_Horizons\.minecraft\dumps

# HuijiWiki MediaWiki API endpoint.
BASE_URL=https://gtnh.huijiwiki.com/api.php

# HuijiWiki auth key, if required by the target wiki.
AUTHKEY=

# Normal editor account used by wiki.py.
EDITOR_USERNAME=
EDITOR_PASSWORD=

# Bot account used by batch upload scripts.
BOT_USERNAME=
BOT_PASSWORD=

# Each split/inventory/upload run handles this one source and destination version.
# MOD_LOCAL_NAME=GTNH reads the full dump; research excludes the extra addon IDs
# listed in databaseDump/config/addon-mods.json. Addons use their registered mod ID
# locally (sourceMod for research), while MOD_REMOTE_NAME names the Wiki directory.
MOD_LOCAL_NAME=sciencenotleisure
MOD_REMOTE_NAME=GTNotLeisure
MOD_VERSION=0.2.7-rc2
